#!/usr/bin/env bash
# The one check loop. CI runs exactly this, on macOS and on Linux.
#
#   scripts/check            everything this platform can run
#   scripts/check <filter>   format, lint and file sizes, then only the tests matching <filter>
#                            (a `swift test --filter` pattern, such as `RouterTests` or `shadowing`)
#
# On macOS: format, lint, file sizes, every test, a release build of every product, and whitespace.
# On Linux: the same for the Foundation-only targets (core, CLI, editor). It says what it skipped,
# and a Linux pass means "the macOS checks were not run".
#
# Exit codes: 10 format, 11 lint, 12 tests, 13 file sizes, 14 build, 16 whitespace.
# Test failures are repeated at the end of the output. The full log is in .build/check.log.
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  sed -n '2,/^set /p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
  exit 0
fi

filter="${1:-}"
mkdir -p .build
log=.build/check.log
: > "$log"
stage() { printf '\n==> %s\n' "$1"; }
fail() { printf '\ncheck: %s\n' "$2" >&2; exit "$1"; }

if [[ "$(uname -s)" == Darwin ]]; then
  mac=1
  swift_format=(xcrun swift-format)
else
  mac=0
  swift_format=(swift format)
fi

stage "format"
"${swift_format[@]}" lint --strict --recursive Sources Tests Package.swift \
  || fail 10 "formatting differs; run \`scripts/format\`"

stage "lint"
python3 scripts/lint.py || fail 11 "banned calls; use the suggested owner or add a reasoned exception"

stage "file sizes"
scripts/file-size || fail 13 "a file is over the size limit"

# A hung test would otherwise stall the run forever. The test binary buffers its output when piped,
# so a killed run can't say which test hung; bisect with filters instead.
limit="${CHECK_TEST_TIMEOUT:-600}"   # seconds
timeout_cmd=()
if command -v timeout >/dev/null; then timeout_cmd=(timeout "$limit")
elif command -v gtimeout >/dev/null; then timeout_cmd=(gtimeout "$limit")
fi

stage "test${filter:+ (filter: $filter)}"
if [[ -z "$filter" ]]; then
  swift build --build-tests >>"$log" 2>&1 || { grep -E 'error' "$log" | head -40; fail 12 "the tests didn't build; see $log"; }
  swift test list > .build/test-list.txt 2>>"$log" || fail 12 "the tests couldn't be listed; see $log"
  [[ -s .build/test-list.txt ]] || fail 12 "no tests were discovered"
fi
${timeout_cmd[@]+"${timeout_cmd[@]}"} swift test --disable-xctest ${filter:+--filter "$filter"} 2>&1 | tee -a "$log"
status=${PIPESTATUS[0]}
if (( status == 124 )); then
  # timeout stops `swift test`, not the test binary it started.
  pkill -f 'SwitchboardPackageTests' 2>/dev/null
  fail 12 "tests were still running after ${limit}s and were stopped; find the hung one with
scripts/check <SuiteName> (the suites are the structs in Tests/)"
elif (( status != 0 )); then
  echo
  echo "Failures:"
  grep -E '^✘ ' "$log" | sed 's/^/  /'
  fail 12 "tests failed"
fi
if [[ -n "$filter" ]] && grep -qE 'with 0 tests' "$log"; then
  fail 12 "no tests match '$filter', so nothing was checked"
fi

if [[ -z "$filter" ]]; then
  stage "release build"
  swift build -c release >>"$log" 2>&1 || { grep -E 'error' "$log" | head -40; fail 14 "the release build failed; see $log"; }
fi

stage "whitespace"
git diff --check || fail 16 "whitespace errors"

stage "done"
if [[ -n "$filter" ]]; then
  echo "Filtered checks passed. Run scripts/check with no filter before handing off."
elif (( mac )); then
  echo "All checks passed on macOS."
else
  echo "Linux checks passed. Not run here: the macOS-only targets (Mac glue, UI, app) and their"
  echo "tests. Report this as \"checks passed on Linux; macOS checks not run\"."
fi
