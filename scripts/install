#!/usr/bin/env bash
# Installs the app on this Mac: builds it with scripts/bundle, quits a running copy, replaces
# ~/Applications/<name>.app, and registers it with Launch Services so macOS offers it as a
# browser. With --cli it also links ~/.local/bin/switchboard-rs to the CLI inside the app.
#
#   scripts/install          the app
#   scripts/install --cli    the app and the CLI link
#
# It changes the real machine: agents run it only when the owner asks. Making it the default
# browser is up to the person (System Settings → Desktop & Dock → Default web browser).
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
[[ "$(uname -s)" == Darwin ]] || { echo "install: macOS only" >&2; exit 2; }

identity() { sed -n "s/^pub const $1: &str = \"\(.*\)\";/\1/p" crates/core/src/identity.rs; }
name=$(identity APP_NAME)
id=$(identity BUNDLE_ID)
cli=$(identity CLI_NAME)

scripts/bundle
built="target/bundle/$name.app"
dest="$HOME/Applications/$name.app"
mkdir -p "$HOME/Applications"

if pgrep -f "$dest/Contents/MacOS/" >/dev/null; then
  osascript -e "tell application id \"$id\" to quit" >/dev/null 2>&1 || true
  for _ in $(seq 1 20); do pgrep -f "$dest/Contents/MacOS/" >/dev/null || break; sleep 0.25; done
fi
staging="$HOME/Applications/.$name.app.installing"
rm -rf "$staging"
cp -R "$built" "$staging"
rm -rf "$dest"
mv "$staging" "$dest"

lsregister=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
"$lsregister" -f "$dest"
echo "Installed $dest"

if [[ "${1:-}" == "--cli" ]]; then
  mkdir -p "$HOME/.local/bin"
  ln -sf "$dest/Contents/Helpers/$cli" "$HOME/.local/bin/$cli"
  echo "Linked ~/.local/bin/$cli"
fi
open "$dest"
